rules_version = '2';

// Estructura en lib/services/firestore_service.dart.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function restaurantPath(restaurantId) {
      return /databases/$(database)/documents/restaurants/$(restaurantId);
    }

    function ownsRestaurant(restaurantId) {
      return signedIn() && get(restaurantPath(restaurantId)).data.ownerUid == request.auth.uid;
    }

    // Tras la escritura (batch del registro), el restaurante pertenece a [uid].
    function ownsRestaurantAfter(restaurantId, uid) {
      return restaurantId is string
        && getAfter(restaurantPath(restaurantId)).data.ownerUid == uid;
    }

    function onlyChanges(fields) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(fields);
    }

    // users/{uid}: solo el propio usuario lo lee y escribe. Un perfil de
    // restaurante debe apuntar a un restaurante cuyo dueño sea ese usuario.
    match /users/{uid} {
      allow read: if isSelf(uid);

      allow create: if isSelf(uid)
        && request.resource.data.role in ['cliente', 'restaurante']
        && (request.resource.data.role == 'cliente'
              ? request.resource.data.get('restaurantId', null) == null
              : ownsRestaurantAfter(request.resource.data.get('restaurantId', null), uid));

      // Rol y restaurante solo cambian al vincular un restaurante propio
      // (FirestoreService.createRestaurant).
      allow update: if isSelf(uid)
        && ((request.resource.data.get('role', '') == resource.data.get('role', '')
              && request.resource.data.get('restaurantId', null) == resource.data.get('restaurantId', null))
            || (request.resource.data.role == 'restaurante'
              && ownsRestaurantAfter(request.resource.data.get('restaurantId', null), uid)));

      allow delete: if false;
    }

    // restaurants/{restaurantId}: perfil público; solo el dueño lo modifica.
    match /restaurants/{restaurantId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid;
      allow delete: if false;

      // Índice de PINs activos. El cliente lo crea al apartar; el restaurante
      // (al entregar) o el cliente (al cancelar) lo borran.
      match /activePins/{pin} {
        allow read: if signedIn();
        allow create: if signedIn()
          && getAfter(/databases/$(database)/documents/orders/$(request.resource.data.orderId)).data.userId == request.auth.uid;
        allow delete: if ownsRestaurant(restaurantId)
          || (signedIn() && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.userId == request.auth.uid);
        allow update: if false;
      }
    }

    // packages/{packageId}: el restaurante publica; los clientes solo tocan
    // existencias y disponibilidad al apartar o cancelar.
    match /packages/{packageId} {
      allow read: if signedIn();
      allow create: if ownsRestaurant(request.resource.data.restaurantId);
      allow update: if ownsRestaurant(resource.data.restaurantId)
        || (signedIn() && onlyChanges(['availableQuantity', 'isActive']));
      allow delete: if ownsRestaurant(resource.data.restaurantId);
    }

    // orders/{orderId}: visibles para el cliente que apartó y su restaurante.
    match /orders/{orderId} {
      allow read: if signedIn()
        && (resource.data.userId == request.auth.uid || ownsRestaurant(resource.data.restaurantId));
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if signedIn()
        && onlyChanges(['status', 'cancelledAt', 'deliveredAt'])
        && (resource.data.userId == request.auth.uid || ownsRestaurant(resource.data.restaurantId));
      allow delete: if false;
    }
  }
}
