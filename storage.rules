rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Fotos de paquetes: restaurants/{restaurantId}/packages/{archivo}
    // (StorageService.uploadPackagePhoto). Solo el dueño del restaurante sube.
    match /restaurants/{restaurantId}/packages/{archivo} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && firestore.get(/databases/(default)/documents/restaurants/$(restaurantId)).data.ownerUid == request.auth.uid
        && request.resource.size < 2 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
